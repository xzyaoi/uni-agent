# Copy to config.env and edit paths/account for the receiving JUPITER user.
SCRATCH=/e/scratch/reformo/yao4
WORK_ROOT=${SCRATCH}/coding-agent-trainer
SLURM_ACCOUNT=reformo
PARTITION=booster
TIME_LIMIT=04:00:00
CLUSTER_NNODES=10
NNODES_ROLLOUT=6
TRAINING_IMAGE=${WORK_ROOT}/images/harbor-swe-megatron-lean.aarch64.sqsh
MODEL_PATH=${WORK_ROOT}/models/Qwen3.5-27B
MODEL_SIZE=27B
BENCHMARK=swebench-pro
TP=4
PP=2
GEN_TP=4
TRAINING_STEPS=5
SAVE_FREQ=5
CONCURRENCY=0
ROLLOUT_PROMPT_BSZ=128
NUM_WARMUP_BATCHES=1
CONTINUOUS_ROLLOUT=True
ROLLOUT_TARGET_PROMPTS=128
ROLLOUT_READY_PROMPTS=64
ROLLOUT_REFILL_PROMPTS=16
ROLLOUT_REFILL_INTERVAL=1.0
# Direct native AgentENV; verify the reachable port from a compute node.
AGENTENV_ENDPOINT=http://clnode286.clemson.cloudlab.us:80
AGENTENV_CREDENTIALS=${WORK_ROOT}/secrets/agentenv.env
# Optional absolute binary path if not on PATH after the site's module setup.
APPTAINER_BIN=apptainer
