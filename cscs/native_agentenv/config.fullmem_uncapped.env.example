# Resource profile matching the instrumented Qwen3.5-27B run 3666780.
# Copy to config.env, edit SLURM_ACCOUNT/paths, then run setup.sh and submit.sh.
WORK_ROOT="${SCRATCH}/swe-pro-native-fullmem"
SLURM_ACCOUNT="your-slurm-account"
PARTITION=preemptable
TIME_LIMIT=04:00:00
SLURM_MEM_PER_NODE=850000M
CLUSTER_NNODES=10
NNODES_ROLLOUT=6
TP=4
PP=2
GEN_TP=4
CONCURRENCY=0
# 128 prompts x 8 responses = 1,024 episodes per rollout dispatch.
# Optimizer batch remains 64 prompts, split into four 16-prompt updates.
ROLLOUT_PROMPT_BSZ=128
NUM_WARMUP_BATCHES=1
# Continuous mode replaces the warmup/per-step batch dispatch policy.
CONTINUOUS_ROLLOUT=True
ROLLOUT_TARGET_PROMPTS=128
ROLLOUT_READY_PROMPTS=0
ROLLOUT_REFILL_PROMPTS=16
ROLLOUT_REFILL_INTERVAL=1.0
TRAINING_STEPS=5
SAVE_FREQ=5
TRAINING_IMAGE="/iopsstor/scratch/cscs/xyao/harbor-swe-megatron-lean.aarch64.sqsh"
MODEL_PATH="${SCRATCH}/data/models/Qwen3.5-27B"
AGENTENV_ENDPOINT=http://clnode286.clemson.cloudlab.us:8000
AGENTENV_CREDENTIALS="${WORK_ROOT}/secrets/agentenv.env"
