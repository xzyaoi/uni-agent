# Copy to config.env and edit on the target Clariden account.
# All writable files go below this account's WORK_ROOT on shared scratch.
WORK_ROOT="${SCRATCH}/swe-pro-native"
SLURM_ACCOUNT="your-slurm-account"
PARTITION=preemptable
TIME_LIMIT=11:30:00
# Maximum permitted per-node memory on Clariden; jobs request exclusive nodes.
SLURM_MEM_PER_NODE=850000M

# Shared GH200/aarch64 training image; readable by cluster accounts (mode 0444).
TRAINING_IMAGE="/iopsstor/scratch/cscs/xyao/harbor-swe-megatron-lean.aarch64.sqsh"
# Model weights must be supplied in a location readable by your account.
MODEL_PATH="${SCRATCH}/data/models/Qwen3.5-27B"
# Per-model presets use these paths (uncomment to override defaults):
# MODEL_PATH_4B="${SCRATCH}/data/models/Qwen3.5-4B"
# MODEL_PATH_9B="${SCRATCH}/data/models/Qwen3.5-9B"
# MODEL_PATH_27B="${SCRATCH}/data/models/Qwen3.5-27B"

AGENTENV_ENDPOINT=http://clnode286.clemson.cloudlab.us:8000
# Private shell env file containing: export AGENTENV_API_KEY='...'
AGENTENV_CREDENTIALS="${WORK_ROOT}/secrets/agentenv.env"

CONCURRENCY=64
# Set CONCURRENCY=0 to remove the SWE runner concurrency limit.
TRAINING_STEPS=5
# Prompts per rollout dispatch, independent of the 64-prompt optimizer batch.
ROLLOUT_PROMPT_BSZ=64
NUM_WARMUP_BATCHES=1
# Optional steady producer; the experiment profile enables it.
CONTINUOUS_ROLLOUT=False
ROLLOUT_TARGET_PROMPTS=128
ROLLOUT_READY_PROMPTS=64
ROLLOUT_REFILL_PROMPTS=16
ROLLOUT_REFILL_INTERVAL=1.0
SAVE_FREQ=5
# WebArena additionally needs hosted sites and a browser image; see webarena/README.md.
# WEBARENA_IMAGE=ghcr.io/your-account/webarena:0.14.3
# WEBARENA_ENV_FILE="${WORK_ROOT}/secrets/webarena.env"
# WEBARENA_CONCURRENCY=1
# All model presets conservatively keep the original 8-trainer + 2-rollout topology.
# CLUSTER_NNODES=10
# NNODES_ROLLOUT=2
# TP=4 PP=2 GEN_TP=4
# Optional: export WANDB_API_KEY and WANDB_ENTITY in your shell before submit.
