# Copy to config.env and edit on the target Clariden account.
# All writable files go below this account's WORK_ROOT on shared scratch.
WORK_ROOT="${SCRATCH}/swe-pro-native"
SLURM_ACCOUNT="your-slurm-account"
PARTITION=preemptable
TIME_LIMIT=11:30:00

# Shared GH200/aarch64 training image; readable by cluster accounts (mode 0444).
TRAINING_IMAGE="/iopsstor/scratch/cscs/xyao/harbor-swe-megatron-lean.aarch64.sqsh"
# Model weights must be supplied in a location readable by your account.
MODEL_PATH="${SCRATCH}/data/models/Qwen3.5-27B"

AGENTENV_ENDPOINT=http://clnode286.clemson.cloudlab.us:8000
# Private shell env file containing: export AGENTENV_API_KEY='...'
AGENTENV_CREDENTIALS="${WORK_ROOT}/secrets/agentenv.env"

CONCURRENCY=64
TRAINING_STEPS=5
SAVE_FREQ=5
# Optional: export WANDB_API_KEY and WANDB_ENTITY in your shell before submit.
