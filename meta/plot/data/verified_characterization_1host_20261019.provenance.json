  "definitions": {
    "rollout_window": "[model_ready_at, model_ready_at + rollout_wall_seconds]; exclude startup, final artifact latency and Slurm cleanup.",
    "sandbox_cpu": "Single 96-vCPU whole-host /proc/stat first-eight counter deltas: busy = 100 * (sum - idle - iowait) / sum. Exclude guest fields to avoid double counting. Treat the rate as constant over its observation interval, clip to the rollout window and duration-weight the mean over valid coverage. Exclude nonpositive intervals, counter resets and gaps longer than 15 seconds. Do not extrapolate.",
    "sandbox_ram": "100 * (MemTotal - MemAvailable) / MemTotal for the whole AWS host, including VMs, runtime services and the OS. Hold each sample until the next sample, clip to the rollout window, exclude gaps longer than 15 seconds and do not extrapolate. Capacity is kernel-reported MemTotal, approximately 377.5 GiB.",
    "cpu_ram_peak": "Largest duration-weighted mean in a fully covered five-second bin anchored at model_ready_at. Full-coverage tolerance is 1e-5 seconds. This is not an instantaneous peak.",
    "cpu_ram_coverage": "Observed valid interval duration / rollout_wall_seconds * 100. Missing time is not treated as idle. This is a single-host measurement.",
    "inference": {
      "rollout_window": "model_ready_at <= sample timestamp <= model_ready_at + rollout_wall_seconds; initialization and cleanup excluded",
      "hardware": "Two inference nodes, four GH200 GPUs per node, two TP4 vLLM replicas; eight GPUs total",
      "gpu_utilization_mean_pct": "Arithmetic mean of eight NVIDIA utilization.gpu percent readings per aligned two-node sample, then equal-weight mean over paired samples; each node must report four GPU UUIDs",
      "dcgm_mean_pct": "Equal-weight mean of per-GPU sample means across eight GPUs; SMACT/TENSO fractions multiplied by100",
      "replica_alignment": "One-to-one chronological matching of nearest available samples with absolute timestamp skew <=1.0s; unmatched samples excluded from fleet request totals and NVIDIA fleet utilization; no interpolation or summing separate peaks",
      "running_requests": "vllm:num_requests_running: requests in execution batches, not all live benchmark episodes",
      "waiting_requests": "vllm:num_requests_waiting, summed across aligned replica samples",
      "kv_cache": "vllm:kv_cache_usage_perc is a fraction,1=100%; values multiplied by100. Per-replica means use every valid in-window sample; fleet mean equally weights the two replica means. Largest peak is largest observed single-replica five-second sample",
      "preemptions": "Sum of nonnegative successive deltas of vllm:num_preemptions_total per replica within the strict rollout window; counter resets counted; events before first in-window sample cannot be inferred",
      "peaks": "Observed approximately five-second sampled values, not minute averages or continuous-time maxima",
      "weighting": "Sample means, not time-integrated means; observed cadence/coverage included below"
    },
    "client_active_requests_mean": "Sum of complete model/chat_completion begin-to-end or begin-to-error interval lengths after clipping to the rollout window, divided by rollout seconds. Client duration includes RPC transport, queuing, prefill and decode. It is distinct from executing vLLM requests and live benchmark episodes.",
    "client_active_requests_peak": "Maximum simultaneous matched model-call intervals within the rollout window. Match by (model_client_id, operation_id); process ends before begins at identical timestamps. This is an exact trace-event overlap peak, without five-second resampling.",
    "client_trace_completeness": "Read all captured model records to clip calls crossing window boundaries. Exclude and count unmatched events. Collapse duplicate phases to the earliest begin and latest end.",
    "usable_trajectories": "result.progress.episodes_with_usable_trajectory, distinct from completed Harbor verifications and solved tasks.",
    "usable_trajectories_per_minute": "usable_trajectories * 60 / result.rollout_wall_seconds; exclude model initialization.",
    "terminal_attempts_per_minute": "Harbor terminal_results * 60 / rollout_wall_seconds, including incomplete verification.",
    "verified_attempts_per_minute": "Harbor evaluation_completed * 60 / rollout_wall_seconds, including valid zero rewards.",
    "scheduler_state": "Use archived scheduler-final.json when present. NOT_YET_ARCHIVED means the measurement completed but its final Slurm receipt was unavailable at freeze; it is not an inferred Slurm state.",
    "uncertainty": "One measurement per concurrency point; no replicate uncertainty or confidence intervals are implied."
  },
