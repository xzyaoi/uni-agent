  "definitions": {
    "sandbox_cpu": {
      "window": "[model_ready_at, model_ready_at + rollout_wall_seconds]; finished_at is not used as the endpoint",
      "counter_fields": "First eight aggregate /proc/stat cpu ticks: user,nice,system,idle,iowait,irq,softirq,steal. guest and guest_nice columns excluded to avoid counting VM guest time twice; guest time remains included once through user/nice.",
      "busy_pct": "100 * (sum(delta(first8)) - delta(idle) - delta(iowait)) / sum(delta(first8))",
      "host_scope": "Whole AWS sandbox host including VM execution, AgentENV/control services, and OS; not isolated VM CPU attribution",
      "host_capacity_vcpus": 96,
      "combined_capacity_vcpus": 192,
      "combined_mean": "For overlapping valid sample intervals, average the two equal-capacity host percentages, then weight by overlap duration. Missing coverage is excluded, never imputed as idle.",
      "interval_assumption": "Each adjacent CPU counter delta describes a constant average rate on its observation interval; intervals are clipped to the requested window. Counter resets, nonpositive durations, and gaps over 15 seconds are excluded.",
      "combined_peak": "Maximum combined mean in a complete 5-second bin anchored at model_ready_at, requiring full valid coverage from both hosts; derived by integrating overlapping raw interval averages. This is a resampled approximately-5-second peak, not instantaneous utilization.",
      "per_host_peak": "Maximum valid adjacent-sample CPU average, with its clipped interval recorded; typically approximately 5 seconds.",
      "minute_csv_comparison": "Existing cluster CSV arithmetic mean is reported only as a diagnostic. Equal weighting of partial minute bins differs from duration-weighted rollout CPU.",
      "full_window_mean_bounds": "Conservative bounds assume all uncovered seconds range from 0 to 100% combined busy; the primary mean uses observed common coverage only."
    },
    "inference": {
      "rollout_window": "model_ready_at <= sample timestamp <= model_ready_at + rollout_wall_seconds; initialization and cleanup excluded",
      "hardware": "Two inference nodes, four GH200 GPUs per node, two TP4 vLLM replicas; eight GPUs total",
      "gpu_utilization_mean_pct": "Arithmetic mean of eight NVIDIA utilization.gpu percent readings per aligned two-node sample, then equal-weight mean over paired samples; each node must report four GPU UUIDs",
      "dcgm_mean_pct": "Equal-weight mean of per-GPU sample means across eight GPUs; SMACT/TENSO fractions multiplied by100",
      "replica_alignment": "One-to-one chronological matching of nearest available samples with absolute timestamp skew <=1.0s; unmatched samples excluded from fleet request totals and NVIDIA fleet utilization; no interpolation or summing separate peaks",
      "running_requests": "vllm:num_requests_running: requests in execution batches, not all live benchmark episodes",
      "waiting_requests": "vllm:num_requests_waiting, summed across aligned replica samples",
      "kv_cache": "vllm:kv_cache_usage_perc is a fraction,1=100%; values multiplied by100. Per-replica means use every valid in-window sample; fleet mean equally weights the two replica means. Largest peak is largest observed single-replica five-second sample",
      "preemptions": "Sum of nonnegative successive deltas of vllm:num_preemptions_total per replica within the strict rollout window; counter resets counted; events before first in-window sample cannot be inferred",
      "peaks": "Observed approximately five-second sampled values, not minute averages or continuous-time maxima",
      "weighting": "Sample means, not time-integrated means; observed cadence/coverage included below"
    },
    "terminal_attempts": "Harbor terminal_results: trial finished, including incomplete verification. This is not resolved tasks.",
    "verified_attempts": "Harbor evaluation_completed: completed verifier evaluation, including valid zero rewards.",
    "incomplete_verifications": "Harbor evaluation_incomplete, or terminal_results minus evaluation_completed if that field is absent; verified+incomplete=1024 at every point.",
    "usable_trajectories": "Final progress.episodes_with_usable_trajectory; distinct from completed verification and resolved attempts.",
    "terminal_attempts_per_minute": "terminal_attempts *60 / result.rollout_wall_seconds. Model initialization excluded.",
    "verified_attempts_per_minute": "verified_attempts *60 / result.rollout_wall_seconds. Model initialization excluded.",
    "rollout_window_epochs": "window_start_epoch=result.model_ready_at; window_end_epoch=window_start_epoch+result.rollout_wall_seconds. Final artifact-writing/cleanup latency through finished_at is excluded.",
    "job_id": "scheduler-final.json job_id, with scheduler_state=COMPLETED and result_state=completed required.",
    "concurrency_episodes": "Maximum live benchmark episode ceiling: group_concurrency *8 responses. It differs from instantaneous active vLLM inference requests.",
    "uncertainty": "One measurement per concurrency point; descriptive results only, without confidence intervals or replicate-based uncertainty.",
    "sandbox_ram": {
      "window": "[model_ready_at, model_ready_at + rollout_wall_seconds]; startup and final artifact/cleanup time excluded.",
      "host_ram_used_bytes": "MemTotal - MemAvailable from Linux /proc/meminfo. Kernel kB values multiplied by1024.",
      "host_ram_utilization_pct": "100 * (MemTotal - MemAvailable) / MemTotal.",
      "fleet_ram_utilization_pct": "100 * sum(host MemTotal - host MemAvailable) / sum(host MemTotal), requiring both hosts simultaneously. Weighting is by RAM capacity, not vCPU count.",
      "scope": "Whole AWS sandbox-host RAM, including operating system, VM/runtime/control services and other nonavailable memory. MemAvailable includes the kernel estimate of reclaimable memory. This is not aenv anonymous/cgroup memory, VM RSS alone, or GPU VRAM.",
      "gauge_interpolation": "Zero-order hold: each valid memory sample applies from its timestamp until the next valid sample, with intervals clipped to the rollout window. No extrapolation before first or after last sample. Nonpositive intervals and gaps over15seconds excluded.",
      "fleet_mean": "Duration-weighted mean of fleet RAM utilization over common valid coverage from both hosts; uncovered time is excluded, not zero-filled.",
      "fleet_peak_5s": "Maximum duration-weighted fleet RAM utilization in a complete5-second bin anchored at model_ready_at, requiring full coverage from both hosts. This is a resampled5-second mean of held gauges, not an instantaneous maximum.",
      "capacity_gib": "Sum of observed OS MemTotal bytes /2^30 across both sandbox hosts. This is usable kernel-reported capacity, not advertised hardware RAM.",
      "mean_and_peak_used_gib": "Fleet used bytes summed across both hosts; mean time-weighted over common coverage; peak uses the same complete5-second bins.",
      "per_host_peak": "Maximum observed in-window sample of100*(MemTotal-MemAvailable)/MemTotal; not plotted as the fleet peak.",
      "full_window_mean_bounds": "Conservative bounds assign all uncovered seconds0% or100% fleet utilization; the primary mean only uses common observed coverage."
    }
  },
