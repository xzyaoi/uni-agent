  "offline_contract": "This frozen CSV and provenance are sufficient for plotting; ignored outputs sources are audit references only. Plot loaders must not require raw outputs. No raw telemetry or trajectory bodies were copied.",
  "definitions": {
    "rollout_window": "[model_ready_at, model_ready_at + rollout_wall_seconds], using each result.json. Model/framework startup and final artifact/cleanup latency excluded.",
    "usable_trajectories": "result.progress.episodes_with_usable_trajectory; this is stored usable training trajectories, not reward verification success or resolved tasks.",
    "usable_trajectories_per_minute": "usable_trajectories *60 / rollout_wall_seconds.",
    "terminal_attempts": "Harbor terminal_results, including incomplete verification. This is not a count of successful evaluations.",
    "verified_attempts": "Harbor evaluation_completed, including completed zero rewards.",
    "sandbox_cpu": "Aggregate /proc/stat first8 ticks user,nice,system,idle,iowait,irq,softirq,steal. Busy%=100*(sum(delta(first8))-delta(idle)-delta(iowait))/sum(delta(first8)); guest/guest_nice columns excluded to avoid counting guest time twice.",
    "sandbox_ram": "Whole sandbox-host RAM100*(MemTotal-MemAvailable)/MemTotal, using Linux /proc/meminfo kB*1024; includes OS/runtime/VM nonavailable memory, not aenv anonymous memory or GPU VRAM.",
    "sample_intervals": "CPU delta average is constant on each adjacent sample interval; RAM gauge holds the left sample to the next sample. Clip intervals to the strict rollout window; exclude nonpositive intervals, gaps>15s, and invalid/reset CPU deltas. No extrapolation outside available sample pairs.",
    "resource_means": "Duration-weighted utilization over observed valid intervals; uncovered time is excluded, not imputed as idle. Single AWS sandbox host only.",
    "resource_peak_5s": "Maximum fully covered resampled5-second mean anchored at model_ready_at. Bins require complete valid coverage with tolerance1e-5seconds. These are approximately5-second averages, not instantaneous peaks.",
    "sandbox_ram_total_gib": "Observed MemTotal bytes/2^30 on the single AWS sandbox host; constant across samples.",
    "client_active_requests_mean": "Sum of clipped model RPC begin-to-end/error durations divided by the full rollout wall time; pairs matched by(model_client_id,operation_id). This counts client requests in flight, including server queues, network time and failed-call waiting. It is NOT vLLM engine-running requests.",
    "client_active_requests_peak": "Exact maximum concurrent model RPC intervals from event order, with terminal events processed before begin events at equal timestamps. This is an event-derived peak, not a sampled engine request count.",
    "verifier_exec_timeout_seconds": "Historical accidental180-second native SDK command timeout; it truncated verifier commands even when Harbor phase deadlines were longer.",
    "engine_failure": "True only at C512: EngineDeadError appears in the training log and702 model RPCs end in error.",
    "result_vs_scheduler_state": "The rollout runner wrote a completed result after128 terminal groups; all four Slurm jobs later reportedFAILED during Ray teardown. Result completion does not establish all trajectories or verifications succeeded.",
    "uncertainty": "One stochastic run per concurrency, without replicate-based uncertainty. Image cache state and trajectories can vary."
  },
